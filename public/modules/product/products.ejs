    <div class="auth-modal">
      <button class="auth-close-btn" id="auth-close-btn">&times;</button>
      
      <!-- Register Panel -->
      <div class="auth-panel" id="register-panel">
        <h2 class="auth-title">Nelo<span>fy</span></h2>
        <p>Silahkan masukan data untuk membuat akun</p>
        <div class="auth-form-group">
          <input type="text" class="auth-input" id="reg-fullname" placeholder="Full Name" required>
        </div>
        <div class="auth-form-group">
          <input type="text" class="auth-input" id="reg-username" placeholder="Username" required>
        </div>
        <div class="auth-form-group">
          <input type="email" class="auth-input" id="reg-email" placeholder="Email" required>
        </div>
        <div class="auth-form-group">
          <input type="password" class="auth-input" id="reg-pass" placeholder="Password" required>
        </div>
        <div class="auth-form-group">
          <input type="tel" class="auth-input" id="reg-phone" placeholder="Phone Number" required>
        </div>
        <button class="auth-submit-btn" id="btn-register" onclick="register()">Registrasi</button>

         <div class="auth-divider">atau</div>

        <a class="auth-google-btn" id="btn-google-login" href="https://e10b-180-254-122-151.ngrok-free.app/auth/google">
