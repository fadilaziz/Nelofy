  <!-- ─── CONFIRM MODAL ─── -->
  <div class="confirm-overlay" id="confirm-overlay">
    <div class="confirm-modal">
      <div class="confirm-title" id="confirm-title">Konfirmasi</div>
      <div class="confirm-message" id="confirm-message">Apakah Anda yakin?</div>
      <div class="confirm-actions">
        <button class="btn-confirm-cancel" id="confirm-cancel-btn">Batal</button>
        <button class="btn-confirm-ok" id="confirm-ok-btn">Ya, Yakin</button>
      </div>
    </div>
  </div>

  <!-- ─── HELP MODAL ─── -->
  <div class="help-overlay" id="help-overlay" onclick="closeHelpModalOnBackdrop(event)">
    <div class="help-modal" role="dialog" aria-modal="true" aria-labelledby="help-modal-title">

      <!-- Header -->
      <div class="help-modal-header">
        <div class="help-modal-title" id="help-modal-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          Pusat Bantuan
        </div>
        <button class="help-modal-close" onclick="closeHelpModal()" aria-label="Tutup">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Body -->
      <div class="help-modal-body">

        <!-- Info hint -->
        <div class="help-search-hint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>Temukan jawaban atas pertanyaan umum di bawah ini, atau hubungi tim kami secara langsung jika membutuhkan bantuan lebih lanjut.</span>
        </div>

        <!-- FAQ -->
        <div>
          <div class="help-section-title">Pertanyaan Umum</div>
          <div class="help-faq">

            <div class="help-faq-item">
              <button class="help-faq-q" onclick="toggleFaq(this)">
                Bagaimana cara membeli modul?
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="help-faq-a">Pilih modul yang kamu inginkan, klik tombol <strong>Beli Sekarang</strong>, lalu selesaikan pembayaran. Akses modul akan aktif otomatis setelah pembayaran terkonfirmasi.</div>
            </div>

            <div class="help-faq-item">
              <button class="help-faq-q" onclick="toggleFaq(this)">
                Metode pembayaran apa saja yang tersedia?
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="help-faq-a">Kami mendukung berbagai metode pembayaran: transfer bank (BCA, Mandiri, BNI, BRI), dompet digital (QRIS, GoPay, OVO, Dana), dan kartu kredit/debit.</div>
            </div>

            <div class="help-faq-item">
              <button class="help-faq-q" onclick="toggleFaq(this)">
                Apakah ada masa berlaku akses modul?
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="help-faq-a">Akses modul bersifat <strong>lifetime</strong> — sekali beli, bisa diakses selamanya termasuk update konten di masa mendatang.</div>
            </div>

            <div class="help-faq-item">
              <button class="help-faq-q" onclick="toggleFaq(this)">
                Bagaimana jika pembayaran saya tidak terproses?
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="help-faq-a">Cek status transaksi di halaman <strong>Riwayat Pembelian</strong> di profil kamu. Jika saldo terpotong namun status masih pending lebih dari 30 menit, hubungi kami via WhatsApp atau email.</div>
            </div>

            <div class="help-faq-item">
              <button class="help-faq-q" onclick="toggleFaq(this)">
                Bagaimana cara mendapatkan diskon 10%?
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="help-faq-a">Diskon 10% diberikan otomatis untuk pembelian pertama setelah kamu mendaftar dan login ke akun Nelofy. Tidak perlu kode promo.</div>
            </div>

          </div>
        </div>

        <!-- Kontak -->
        <div>
          <div class="help-section-title">Hubungi Kami</div>
          <div class="help-contact-list">

            <a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="help-contact-item">
              <div class="help-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
                </svg>
              </div>
              <div class="help-contact-info">
                <div class="help-contact-label">WhatsApp</div>
                <div class="help-contact-sub">Respons cepat — Senin s/d Sabtu, 08.00–17.00 WIB</div>
              </div>
              <div class="help-contact-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </a>

            <a href="mailto:support@nelofy.id" class="help-contact-item">
              <div class="help-contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="help-contact-info">
                <div class="help-contact-label">Email</div>
                <div class="help-contact-sub">support@nelofy.id</div>
              </div>
              <div class="help-contact-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </a>

          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ─── LUPA PASSWORD MODAL ─── -->
  <div class="auth-overlay" id="forgot-password-overlay" onclick="if(event.target === this) closeForgotPasswordModal()" style="display: none; align-items: center; justify-content: center; z-index: 10000; position: fixed; inset: 0; background: rgba(0,0,0,0.5);">
    <div class="auth-panel" style="display: block; position: relative; max-width: 400px; width: 90%; padding: 32px 24px; text-align: center;">
      <button onclick="closeForgotPasswordModal()" style="position: absolute; right: 16px; top: 16px; background: none; border: none; cursor: pointer; color: #555;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--black); margin-bottom: 16px;">
        <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <h3 style="margin-bottom: 12px; font-size: 20px;">Lupa Password?</h3>
      <p style="font-size: 14px; color: #555; line-height: 1.5; margin-bottom: 24px;">
        Masukkan email yang terdaftar pada akun Anda. Kami akan mengirimkan tautan untuk mereset password Anda.
      </p>
      <div class="auth-form-group">
        <input type="email" class="auth-input" id="forgot-password-email-input" placeholder="Alamat Email" required>
      </div>
      <div style="display: flex; gap: 12px; margin-top: 24px;">
        <button style="flex: 1; padding: 12px; background: white; border: 1px solid #ddd; border-radius: 6px; cursor: pointer; font-weight: 600;" onclick="closeForgotPasswordModal()">Batal</button>
        <button id="btn-submit-forgot" style="flex: 1; padding: 12px; background: #111; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;" onclick="submitForgotPassword()">Kirim</button>
      </div>
    </div>
  </div>

  <script>
    /* ── Help Modal ── */
    function openHelpModal(e) {
      e && e.preventDefault();
      document.getElementById('help-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    /* ── Lupa Password Modal ── */
    function openForgotPasswordModal(e) {
      e && e.preventDefault();
      // Sembunyikan panel login jika sedang terbuka
      const authOverlay = document.getElementById('auth-overlay');
      if(authOverlay) authOverlay.classList.remove('open');
      
      const forgotOverlay = document.getElementById('forgot-password-overlay');
      forgotOverlay.style.display = 'flex';
      // Trigger reflow for transition
      forgotOverlay.offsetHeight;
      forgotOverlay.classList.add('open');
      
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function closeForgotPasswordModal() {
      const forgotOverlay = document.getElementById('forgot-password-overlay');
      forgotOverlay.classList.remove('open');
      
      // Tunggu transisi selesai sebelum hide display
      setTimeout(() => {
        forgotOverlay.style.display = 'none';
      }, 300);
      
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.getElementById('forgot-password-email-input').value = '';
    }

    async function submitForgotPassword() {
      const emailInput = document.getElementById('forgot-password-email-input');
      const email = emailInput.value.trim();
      
      if (!email) {
        showNotification('Mohon masukkan email Anda', 'error');
        return;
      }

      const btn = document.getElementById('btn-submit-forgot');
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Loading...';
      btn.disabled = true;

      try {
        const baseUrl = localStorage.getItem('base_url_api');
        const response = await fetch(`${baseUrl}/request_reset_password`, {
          method: 'POST',
          credentials: 'include', 
          headers: {
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          },
          body: JSON.stringify({ email: email })
        });
        
        const data = await response.json();
        
        if (data.status === 'success') {
          showNotification('Link reset password berhasil dikirim!', 'success');
          closeForgotPasswordModal();
        } else {
          showNotification('Gagal mengirim: ' + (data.message || 'Terjadi kesalahan'), 'error');
        }
      } catch (error) {
        console.error(error);
        showNotification('Terjadi kesalahan jaringan.', 'error');
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

    function closeHelpModal() {
      document.getElementById('help-overlay').classList.remove('open');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
    function closeHelpModalOnBackdrop(e) {
      if (e.target === document.getElementById('help-overlay')) closeHelpModal();
    }
    /* Close on Escape */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeHelpModal();
        closeForgotPasswordModal();
      }
    });
    /* FAQ accordion */
    function toggleFaq(btn) {
      const item = btn.closest('.help-faq-item');
      const isOpen = item.classList.contains('open');
      /* Close all */
      document.querySelectorAll('.help-faq-item.open').forEach(el => el.classList.remove('open'));
      /* Open clicked (unless it was already open) */
      if (!isOpen) item.classList.add('open');
    }

    /* ── Sidebar Filter ── */
    function openSidebarFilter() {
      document.getElementById('sidebar-filter').classList.add('open');
      document.getElementById('sidebar-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }
    function closeSidebarFilter() {
      document.getElementById('sidebar-filter').classList.remove('open');
      document.getElementById('sidebar-overlay').classList.remove('open');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
  </script>
</body>
</html>
