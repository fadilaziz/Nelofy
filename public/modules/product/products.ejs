      <!-- Login Panel -->
      <div class="auth-panel" id="login-panel">
        <h2 class="auth-title">Nelo<span>fy</span></h2>
        <p>Silahkan masukan email dan password kamu untuk masuk ke akun kamu</p>
        <div class="auth-form-group">
          <input type="email" class="auth-input" id="login-email" placeholder="Email" required>
        </div>
        <div class="auth-form-group">
          <input type="password" class="auth-input" id="login-pass" placeholder="Password" required>
        </div>
        <a href="#" id="lupa-password" onclick="openForgotPasswordModal(event)">Lupa Password ?</a>
        <button class="auth-submit-btn" id="btn-login" onclick="login()">Masuk</button>

        <div class="auth-divider">atau</div>

        <a class="auth-google-btn" id="btn-google-login" href="https://e10b-180-254-122-151.ngrok-free.app/auth/google">
