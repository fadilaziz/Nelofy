        <div class="footer-col">
          <h4>Produk</h4>
          <ul class="footer-links">
            <li><a href="#">Semua Modul</a></li>
            <li><a href="#">Kelas Bootcamp</a></li>
            <li><a href="#">E-Book Gratis</a></li>
            <li><a href="#">Sertifikasi</a></li>
