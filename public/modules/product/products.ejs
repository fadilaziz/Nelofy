<body>

  <!-- ─── TOP ANNOUNCEMENT BAR ─── -->
  <div id="topbar"></div>

  <!-- ─── NAVBAR ─── -->
  <nav class="navbar"></nav>

  <!-- ─── MAIN CONTENT ─── -->
  <div class="container">

    <!-- PAGE HEADER
    <div class="page-header">
      <h1>Modul Pilihan</h1>
      <div class="result-meta">
        <div class="category-label">Modules</div>
        <div class="result-count">— 5 tersedia</div>
      </div>
    </div> -->
  </div> <!-- /container -->

  

  <!-- ─── FILTER BAR ─── -->
  <div class="filter-section">
    <div class="container">
      <div class="filter-bar">
        <span class="filter-label" id="total-product"></span>
        <span class="filter-spacer"></span>

        <!--SEARCH BAR-->
        <div class="search-wrapper">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="search" id="product-search" class="search-input" placeholder="Cari modul" autocomplete="off">
        </div>

      <button class="filter-open-btn" id="filter-open-btn" onclick="openSidebarFilter()">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6"  x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
        Filter
      </button>

      <select class="sort-select">
        <option>Terbaru</option>
        <option>Harga: Rendah ke Tinggi</option>
        <option>Harga: Tinggi ke Rendah</option>
        <option>Paling Populer</option>
        <option>Nama: A–Z</option>
      </select>
      </div>
    </div>
  </div>

  <!-- ─── PRODUCT GRID & SIDEBAR ─── -->
  <div class="container main-layout">
    
    <!-- SIDEBAR -->
    <aside class="sidebar-filter" id="sidebar-filter">
       <div class="sidebar-header">
         <h3>Filter</h3>
         <button class="sidebar-close-btn" onclick="closeSidebarFilter()">
           <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
         </button>
       </div>

       <div class="sidebar-block">
         <h4 class="sidebar-title">Kategori</h4>
         <label class="sidebar-check">
           <input type="checkbox" class="kategori-check" data-value="semua" checked> Semua
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="kategori-check" data-value="Web Development"> Web Development
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="kategori-check" data-value="Data Science"> Data Science
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="kategori-check" data-value="UI/UX Design"> UI/UX Design
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="kategori-check" data-value="Digital Marketing"> Digital Marketing
         </label>
       </div>

       <div class="sidebar-block">
         <h4 class="sidebar-title">Tingkat</h4>
         <label class="sidebar-check">
           <input type="checkbox" class="tingkat-check" data-value="semua" checked> Semua Tingkat
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="tingkat-check" data-value="Pemula"> Pemula
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="tingkat-check" data-value="Menengah"> Menengah
         </label>
         <label class="sidebar-check">
           <input type="checkbox" class="tingkat-check" data-value="Lanjut"> Lanjut
         </label>
       </div>

       <div class="sidebar-block" style="border-bottom: none; padding-top: 8px;">
         <button id="sidebar-reset-btn" style="width:100%;padding:10px;background:transparent;border:1px solid var(--gray-300);border-radius:8px;font-size:13px;font-weight:600;color:var(--gray-600);cursor:pointer;font-family:var(--font);transition:all 0.2s ease;">
           Reset Filter
         </button>
       </div>
    </aside>

    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebarFilter()"></div>

    <!-- MAIN CONTENT -->
    <section class="products-section">
      <div class="product-grid" id="product-container">
        <!--Card products-->
      </div>

      <!-- PAGINATION -->
      <div class="pagination">
        <a href="#" class="page-btn disabled">‹</a>
        <a href="#" class="page-btn active">1</a>
        <a href="#" class="page-btn disabled">›</a>
      </div>
    </section>

  </div><!-- /container -->

