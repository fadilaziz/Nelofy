<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pembayaran — Nelofy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../../assets/css/global.css" />
    <link rel="stylesheet" href="../../assets/css/navbar.css" />
    <link rel="stylesheet" href="../../assets/css/payment.css" />
    <script defer src="../../assets/javascript/global.js"></script>
    <script defer src="../../assets/javascript/navbar.js"></script>
    <script defer src="../../assets/javascript/product.js"></script>
    <script defer src="../../assets/javascript/payment.js"></script>
    <script>
      localStorage.setItem('base_url_api', '<%= process.env.BASE_API_URL %>');
    </script>
  </head>

  <body>
    <!-- ── Navbar ── -->
    <nav class="navbar">
      <div style="display: flex; align-items: center; gap: 20px">
        <a href="/" class="nav-logo">Nelo<span>fy</span></a>
        </a>
      </div>

      <div class="profile-chip-wrapper">
        <div class="nav-profile-chip" id="nav-profile-chip">
          <div class="nav-profile-avatar" id="navbar-profile-avatar"></div>
          <span class="nav-profile-name" id="navbar-profile-name"></span>
        </div>
      </div>
    </nav>

    <div class="container">
      <!-- Loading State -->
      <div id="loading-state" class="loading-state">
        <div class="spinner"></div>
        <span class="loading-text">Memuat data pembayaran...</span>
      </div>

      <!-- Error State -->
      <div id="error-state" class="error-state" style="display: none">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="15" y1="9" x2="9" y2="15" />
          <line x1="9" y1="9" x2="15" y2="15" />
        </svg>
        <h3>Data Tidak Ditemukan</h3>
        <p id="error-message">Tidak ada data pembayaran yang tersedia.</p>
        <a
          href="/products"
          class="btn-primary"
          style="display: inline-flex; width: auto; padding: 12px 24px"
        >
          Kembali Belanja
        </a>
      </div>

      <!-- Payment Content -->
      <div id="payment-content" style="display: none">
        <div class="payment-layout">
          <div class="payment-main">
            <div class="card">
              <div class="invoice-header" style="text-align: left; margin-bottom: 24px">
                <h1 style="font-size: 24px; margin-bottom: 8px">Selesaikan Pembayaran</h1>
                <div class="invoice-id" style="margin-top: 0">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                  </svg>
                  <span id="val-invoice">INV-000000</span>
                </div>
              </div>

              <div class="amount-highlight" style="margin-bottom: 24px">
                <div class="amount-label">Total yang harus dibayar</div>
                <div class="amount-value" id="val-total-tagihan">Rp 0</div>
                <div class="amount-note">
                  Pastikan nominal transfer sesuai hingga digit terakhir
                </div>
              </div>

              <div class="payment-quick-info">
                <div class="status-banner pending" id="status-banner">
                  <div class="status-banner-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                  </div>
                  <div class="status-banner-text">
                    <div class="status-banner-title" id="status-title">Menunggu Pembayaran</div>
                    <div class="status-banner-desc" id="status-desc" style="display: none">
                      Segera lakukan pembayaran sebelum batas waktu berakhir.
                    </div>
                  </div>
                  <div id="status-badge"></div>
                </div>

                <div class="countdown-section" id="countdown-section">
                  <div class="countdown-timer" id="countdown-timer">
                    <div class="countdown-unit">
                      <div class="countdown-value" id="cd-hours">00</div>
                      <span class="countdown-text">Jam</span>
                    </div>
                    <div class="countdown-sep">:</div>
                    <div class="countdown-unit">
                      <div class="countdown-value" id="cd-minutes">00</div>
                      <span class="countdown-text">Min</span>
                    </div>
                    <div class="countdown-sep">:</div>
                    <div class="countdown-unit">
                      <div class="countdown-value" id="cd-seconds">00</div>
                      <span class="countdown-text">Det</span>
                    </div>
                  </div>
                </div>
              </div>


              <div class="divider"></div>

              <div id="payment-instructions-block">
                <div class="card-header" style="padding: 0; margin-bottom: 16px">
                  <div class="card-title">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                      <line x1="1" y1="10" x2="23" y2="10" />
                    </svg>
                    Metode Pembayaran
                  </div>
                </div>

                <div id="bank-transfer-view">
                  <div class="payment-method-box">
                    <div class="pm-icon">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M2 7a2 2 0 012-2h16a2 2 0 012 2v2H2V7z" />
                        <path d="M2 9h20v8a2 2 0 01-2 2H4a2 2 0 01-2-2V9z" />
                        <path d="M6 15h4" />
                      </svg>
                    </div>
                    <div class="pm-info">
                      <div class="pm-name" id="val-payment-method">Transfer Bank</div>
                      <div class="pm-number" id="val-payment-number">—</div>
                    </div>
                    <button class="btn-copy" id="btn-copy-number" onclick="copyToClipboard()">
                      Salin
                    </button>
                  </div>
                </div>

                <div class="qris-section" id="qris-view">
                  <div class="qris-logo">
                    <img
                      src="https://upload.wikimedia.org/wikipedia/commons/a/a2/Logo_QRIS.svg"
                      alt="QRIS"
                    />
                  </div>
                  <div class="qris-frame">
                    <img id="qris-qr-img" src="" alt="QR Code QRIS" />
                  </div>
                  <div class="qris-label">
                    Scan QR code di atas menggunakan aplikasi e-Wallet atau mobile banking
                  </div>
                </div>

                <div class="divider"></div>

                <div class="card-title" style="margin-bottom: 12px; font-size: 14px">
                  Cara Pembayaran
                </div>
                <ol class="steps-list" id="payment-steps">
                  <li>Buka aplikasi mobile banking atau ATM terdekat.</li>
                  <li>Pilih menu Transfer dan masukkan nomor rekening tujuan.</li>
                  <li>Masukkan nominal sesuai total tagihan hingga digit terakhir.</li>
                  <li>Konfirmasi dan simpan bukti transfer Anda.</li>
                </ol>
              </div>
            </div>
          </div>

          <div class="payment-side">
            <div class="card">
              <div class="card-header">
                <div class="card-title">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 01-8 0" />
                  </svg>
                  Detail Pesanan
                </div>
                <span class="badge pending" id="order-badge">
                  <span id="order-badge-text">PENDING</span>
                </span>
              </div>

              <div class="detail-grid">
                <div class="detail-item">
                  <span class="detail-label">Tanggal Pemesanan</span>
                  <span class="detail-value" id="val-tanggal">—</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">ID Pesanan</span>
                  <span class="detail-value" id="val-order-id">—</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Status Invoice</span>
                  <span class="detail-value" id="val-invoice-status">—</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Jatuh Tempo</span>
                  <span class="detail-value" id="val-jatuh-tempo">—</span>
                </div>
              </div>

              <div class="divider"></div>

              <table class="order-table">
                <thead>
                  <tr>
                    <th>Produk</th>
                    <th>Qty</th>
                    <th>Harga</th>
                  </tr>
                </thead>
                <tbody id="order-items-body"></tbody>
              </table>

              <div class="summary-rows">
                <div class="summary-row">
                  <span class="label">Subtotal</span>
                  <span class="value" id="val-subtotal">Rp 0</span>
                </div>
                <div class="summary-row discount" id="discount-row" style="display: none">
                  <span class="label">Diskon</span>
                  <span class="value" id="val-discount">- Rp 0</span>
                </div>
                <div class="summary-row total">
                  <span class="label">Total Tagihan</span>
                  <span class="value" id="val-grand-total">Rp 0</span>
                </div>
              </div>
            </div>

            <div class="actions">
              <a href="/" class="btn-secondary">Kembali Belanja</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="toast-container" class="toast-container"></div>
  </body>
</html>
