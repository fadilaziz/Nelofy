<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout — Billing Payment</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../../assets/css/global.css">
  <link rel="stylesheet" href="../../assets/css/checkout.css">
  <script defer src="../../assets/javascript/global.js"></script>
  <script defer src="../../assets/javascript/checkout.js"></script>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <a href="/products" class="nav-logo">Nelo<span>fy</span></a>
    <div class="profile-chip-wrapper">
      <div class="nav-profile-chip" id="nav-profile-chip">
        <div class="nav-profile-avatar" id="navbar-profile-avatar"></div>
        <span class="nav-profile-name" id="navbar-profile-name"></span>
      </div>
      <div class="profile-dropdown">
          <div class="profile-dropdown-item" id="theme-toggle-btn" style="cursor: pointer; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <svg id="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg id="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              Dark Mode
            </div>
            <div class="theme-switch-track" style="width: 32px; height: 18px; background: var(--gray-300); border-radius: 99px; position: relative; transition: background 0.3s;">
               <div class="theme-switch-handle" style="width: 14px; height: 14px; background: var(--white); border-radius: 50%; position: absolute; top: 2px; left: 2px; transition: transform 0.3s;"></div>
            </div>
          </div>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="checkout-header">
      <h1>Checkout</h1>
    </div>

    <div class="checkout-grid">
      <!-- Left Column (Options Panel) -->
      <div class="checkout-left">

        <div class="panel" id="customer-panel">
          <div class="panel-title">Informasi Pembeli</div>
          <div class="customer-info" id="customer-info">Memuat data...</div>
          
        </div>

        <div class="panel">
          <div class="panel-title" style="margin-bottom: 12px; border: none; padding-bottom: 0;">Metode Pembayaran</div>
          <p style="font-size:13px; color:var(--gray-500); margin-bottom: 16px;">Silakan pilih salah satu layanan dari
            opsi di bawah ini</p>

          <!-- Accordion 1: Rekening Bank -->
          <div class="payment-group" onclick="toggleAccordion('acc-bank')">
            <div class="payment-group-header">
              Transfer Bank (Manual)
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </div>
            <div class="payment-group-content" id="acc-bank" onclick="event.stopPropagation()">
              <div class="bank-list">
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"BANK_BCA", "name":"Transfer Bank BCA", "number":"014 987 654 321", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/5/5c/Bank_Central_Asia.svg" alt="BCA"
                    class="bank-logo">
                  <div class="bank-name">BCA</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"BANK_BRI", "name":"Transfer Bank BRI", "number":"002 123 456 789", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/2/2e/BRI_2020.svg" alt="BRI"
                    class="bank-logo">
                  <div class="bank-name">BRI</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"BANK_BNI", "name":"Transfer Bank BNI", "number":"009 555 444 333", "isQris": false}'
                    onclick="selectPayment()">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/commons/f/f0/Bank_Negara_Indonesia_logo_%282004%29.svg"
                    alt="BNI" class="bank-logo">
                  <div class="bank-name">BNI</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"BANK_BSI", "name":"Transfer Bank BSI", "number":"712 999 888 777", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/a/a0/Bank_Syariah_Indonesia.svg" alt="BSI"
                    class="bank-logo">
                  <div class="bank-name">BSI</div>
                </label>
              </div>
            </div>
          </div>

          <!-- Accordion 2: Virtual Account -->
          <div class="payment-group" onclick="toggleAccordion('acc-va')">
            <div class="payment-group-header">
              Virtual Account
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </div>
            <div class="payment-group-content" id="acc-va" onclick="event.stopPropagation()">
              <div class="bank-list">
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"VA_BCA", "name":"Virtual Account BCA", "number":"88000 014 987", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/5/5c/Bank_Central_Asia.svg" alt="BCA"
                    class="bank-logo">
                  <div class="bank-name">BCA Virtual Account</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"VA_BRI", "name":"Virtual Account BRI", "number":"88000 002 123", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/2/2e/BRI_2020.svg" alt="BRI"
                    class="bank-logo">
                  <div class="bank-name">BRIVA</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"VA_BNI", "name":"Virtual Account BNI", "number":"88000 009 555", "isQris": false}'
                    onclick="selectPayment()">
                  <img
                    src="https://upload.wikimedia.org/wikipedia/commons/f/f0/Bank_Negara_Indonesia_logo_%282004%29.svg"
                    alt="BNI" class="bank-logo">
                  <div class="bank-name">BNI Virtual Account</div>
                </label>
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"VA_BSI", "name":"Virtual Account BSI", "number":"88000 712 999", "isQris": false}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/a/a0/Bank_Syariah_Indonesia.svg" alt="BSI"
                    class="bank-logo">
                  <div class="bank-name">BSI Virtual Account</div>
                </label>
              </div>
            </div>
          </div>

          <!-- Accordion 3: QRIS -->
          <div class="payment-group" onclick="toggleAccordion('acc-qris')">
            <div class="payment-group-header">
              QRIS (Gopay, OVO, Dana)
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </div>
            <div class="payment-group-content" id="acc-qris" onclick="event.stopPropagation()">
              <div class="bank-list">
                <label class="bank-item">
                  <input type="radio" name="pay_opt"
                    value='{"id":"QRIS", "name":"QRIS Payment (All e-Wallet)", "number":"", "isQris": true}'
                    onclick="selectPayment()">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/a/a2/Logo_QRIS.svg" alt="QRIS"
                    class="bank-logo" style="height: 16px;">
                  <div class="bank-name">Scan via Aplikasi Pembayaran</div>
                </label>
              </div>
            </div>
          </div>

        </div>

        <!-- ════════════════════════════════════════
             UPSELL / PRODUK YANG DIREKOMENDASIKAN
        ════════════════════════════════════════ -->
        <div class="panel upsell-section" id="upsell-panel">
          <div class="upsell-header">
            <span class="upsell-badge">
              Rekomendasi
            </span>
            <span class="upsell-title">Produk Lainnya untuk Kamu</span>
          </div>
          <p class="upsell-subtitle">Tambahkan produk lain sebelum menyelesaikan pembayaran.</p>

          <!-- Skeleton Loading State -->
          <div class="upsell-loading-grid" id="upsell-skeleton">
            <div class="upsell-skeleton-card">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:80%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:60%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:40%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:50%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
            <div class="upsell-skeleton-card">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:75%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:55%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:35%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:45%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="upsell-grid" id="upsell-grid" style="display:none;"></div>
        </div>

      </div>

      <!-- Right Column: Summary -->
      <div class="checkout-right">
        <div class="panel" style="position: sticky; top: 80px;">
          <div class="panel-title">Ringkasan Tagihan</div>

          <!-- Tampilkan Data -->
          <div class="summary-items" id="summary-items"></div>

          <div class="voucher-section">
            <input type="text" id="voucher-input" class="voucher-input" placeholder="Punya kode voucher?">
            <button class="btn-apply-voucher" onclick="applyVoucher()">Terapkan</button>
          </div>

          <div class="totals-row">
            <span>Subtotal Produk</span>
            <span id="subtotal-val">Rp 0</span>
          </div>
          <div class="totals-row discount-row" id="discount-row">
            <span>Diskon Voucher</span>
            <span id="discount-val">- Rp 0</span>
          </div>
          <div class="totals-row grand-total">
            <span>Total Tagihan Akhir</span>
            <span id="grand-total-val">Rp 0</span>
          </div>

          <button class="btn-checkout" id="submit-btn" disabled onclick="checkoutToPayment()">Bayar Sekarang</button>
        </div>
      </div>

        <!-- ----------------------------------------
             UPSELL / PRODUK YANG DIREKOMENDASIKAN
        ---------------------------------------- -->
        <div class="panel upsell-section" id="upsell-panel">
          <div class="upsell-header">
            <span class="upsell-badge">
              Rekomendasi
            </span>
            <span class="upsell-title">Produk Lainnya untuk Kamu</span>
          </div>
          <p class="upsell-subtitle">Tambahkan produk lain sebelum menyelesaikan pembayaran.</p>

          <!-- Skeleton Loading State -->
          <div class="upsell-loading-grid" id="upsell-skeleton">
            <div class="upsell-skeleton-card">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:80%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:60%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:40%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:50%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
            <div class="upsell-skeleton-card">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:75%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:55%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:35%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:45%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
            <div class="upsell-skeleton-card desktop-only">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:75%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:55%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:35%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:45%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
            <div class="upsell-skeleton-card desktop-only">
              <div class="upsell-skeleton upsell-skeleton-img"></div>
              <div class="upsell-skeleton-body">
                <div class="upsell-skeleton upsell-skeleton-line" style="width:80%"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:60%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:40%; height:12px;"></div>
                <div class="upsell-skeleton upsell-skeleton-line" style="width:50%; height:18px; margin-top:4px;"></div>
                <div style="display:flex; gap:7px; margin-top:8px;">
                  <div class="upsell-skeleton" style="flex:1; height:34px; border-radius:6px;"></div>
                  <div class="upsell-skeleton" style="width:34px; height:34px; border-radius:6px;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="upsell-grid" id="upsell-grid" style="display:none;"></div>
        </div>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>
</body>

</html>
