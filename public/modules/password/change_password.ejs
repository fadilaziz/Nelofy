<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | Nelofy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="../../assets/css/password.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script defer src="../../assets/javascript/change_password.js"></script>
  <script>
    //Set base_url_api
    localStorage.setItem("base_url_api", "<%= process.env.BASE_API_URL %>");
  </script>
  <link rel="icon" href="../../assets/favicon.png">
  <link rel="stylesheet" href="../../assets/css/global.css">
  <link rel="stylesheet" href="../../assets/css/products.css">
</head>
<body>

  <div class="reset-panel">
    <h2 class="reset-title">Nelo<span>fy</span></h2>
    <p class="reset-subtitle">Silakan masukkan password baru Anda.</p>
    
    <div class="auth-form-group" style="text-align: left; margin-bottom: 20px;">
      <label style="font-size: 13px; font-weight: 600; color: var(--gray-700); margin-bottom: 8px; display: block;">Password Baru</label>
      <input type="password" class="auth-input" id="new-password" placeholder="Minimal 8 karakter" required>
    </div>

    <div class="auth-form-group" style="text-align: left; margin-bottom: 32px;">
      <label style="font-size: 13px; font-weight: 600; color: var(--gray-700); margin-bottom: 8px; display: block;">Konfirmasi Password Baru</label>
      <input type="password" class="auth-input" id="confirm-password" placeholder="Ulangi password baru" required>
    </div>

    <button class="auth-submit-btn" id="btn-submit-reset" onclick="submitNewPassword()">Ganti Password</button>
  </div>
  
  <!-- Toast Container -->
  <div id="toast-container" class="toast-container"></div>
</body>
</html>
