<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Nelofy</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script defer src="../../assets/javascript/forgot_password.js"></script>
    <script>
      localStorage.setItem('base_url_api', 'http://localhost:4100');
    </script>
    <!-- <link rel="stylesheet" href="style.css" /> -->
    <style>
      /* Reset & Base Styles */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
      }

      body {
        background-color: #f8f9fa;
        height: 100vh;
        display: flex;
        justify-content: center; /* Membuat objek center secara horizontal */
        align-items: center; /* Membuat objek center secara vertikal */
        padding: 20px;
      }

      /* Card Container */
      .card-container {
        background-color: #ffffff;
        padding: 40px 35px;
        border-radius: 24px;
        width: 100%;
        max-width: 450px; /* Menjaga ukuran proporsional seperti di gambar */
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        text-align: center;
      }

      /* Brand Logo (Nelofy) */
      .brand-logo {
        font-size: 28px;
        font-weight: 700;
        color: #000000;
        margin-bottom: 12px;
      }

      .brand-logo span {
        color: #8a8d91; /* Memberikan efek warna abu-abu pada 'fy' seperti gambar */
      }

      /* Deskripsi Teks */
      .description {
        font-size: 14px;
        color: #666666;
        line-height: 1.5;
        margin-bottom: 30px;
      }

      /* Input Group (Icon + Input) */
      .input-group {
        position: relative;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
      }

      .input-icon {
        position: absolute;
        left: 16px;
        color: #8a8d91;
        font-size: 16px;
      }

      .input-group input {
        width: 100%;
        padding: 14px 14px 14px 45px; /* Padding kiri lebih besar untuk space icon */
        font-size: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        background-color: #ffffff;
        transition: border-color 0.2s;
      }

      .input-group input:focus {
        border-color: #a0aec0;
      }

      .input-group input::placeholder {
        color: #a0aec0;
      }

      /* Tombol Submit (Masuk / Kirim) */
      .btn-submit {
        width: 100%;
        padding: 14px;
        background-color: #000000; /* Warna hitam solid sesuai tombol 'Masuk' */
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-bottom: 20px;
      }

      .btn-submit:hover {
        background-color: #1a1a1a;
      }

      /* Link Kembali */
      .back-to-login {
        margin-top: 10px;
      }

      .back-to-login a {
        font-size: 13px;
        color: #718096;
        text-decoration: none;
        transition: color 0.2s;
      }

      .back-to-login a:hover {
        color: #000000;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="card-container">
      <h1 class="brand-logo">Nelo<span>fy</span></h1>

      <p class="description">
        Masukkan email terdaftar Admin Anda. Kami akan mengirimkan tautan atau instruksi perubahan
        password ke email tersebut.
      </p>

      <form>
        <div class="input-group">
          <span class="input-icon"><i class="fa-regular fa-envelope"></i></span>
          <input id="email" type="email" placeholder="Email" required />
        </div>

        <button class="btn-submit" id="submit-btn">Kirim</button>
      </form>

      <div class="back-to-login">
        <a href="/" style="color: #808080; text-align: right; text-decoration: none"
          >Kembali ke Halaman Masuk</a
        >
      </div>
    </div>
  </body>
</html>
