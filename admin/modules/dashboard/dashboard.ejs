              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Content -->
        <div class="product-modal-content" style="padding: 24px">
          <form id="user-form" onsubmit="saveUserForm(event)">
            <input type="hidden" id="user-form-id" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px">
              <div class="modal-form-group" style="margin-bottom: 0">
                <label for="uf-fullname">Nama Lengkap</label>
                <input
                  type="text"
                  id="uf-fullname"
                  class="modal-form-input"
                  required
                  placeholder="Contoh: John Doe"
                />
              </div>
              <div class="modal-form-group" style="margin-bottom: 0">
                <label for="uf-username">Username</label>
                <div style="position: relative">
                  <span
                    style="
                      position: absolute;
                      left: 12px;
                      top: 50%;
                      transform: translateY(-50%);
                      color: var(--gray-500);
                      font-weight: 600;
                    "
                    >@</span
                  >
                  <input
                    type="text"
                    id="uf-username"
                    class="modal-form-input"
                    required
                    placeholder="johndoe"
                    style="padding-left: 30px"
                  />
                </div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px">
              <div class="modal-form-group" style="margin-bottom: 0">
                <label for="uf-email">Alamat Email</label>
                <input
                  type="email"
                  id="uf-email"
                  class="modal-form-input"
                  required
                  placeholder="john@example.com"
                />
              </div>
              <div class="modal-form-group" style="margin-bottom: 0">
                <label for="uf-phone">Nomor Telepon</label>
                <input
                  type="tel"
                  id="uf-phone"
                  class="modal-form-input"
                  required
                  placeholder="08123456789"
                />
              </div>
            </div>

            <div class="modal-form-group" style="margin-top: 16px">
              <label for="uf-password" id="uf-password-label">Password</label>
              <input
                type="password"
                id="uf-password"
                class="modal-form-input"
                placeholder="Masukkan password"
              />
              <small
                id="uf-password-hint"
                style="display: none; color: var(--gray-500); font-size: 11px; margin-top: 6px"
                >Biarkan kosong jika tidak ingin mengubah password.</small
              >
            </div>

            <button
              type="submit"
              id="btn-submit-user"
              style="
                width: 100%;
                padding: 14px;
                background: var(--black);
                color: var(--white);
                border: none;
                border-radius: 8px;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: opacity 0.2s;
              "
              onmouseover="this.style.opacity = 0.9"
              onmouseout="this.style.opacity = 1"
            >
              Simpan Perubahan
            </button>
          </form>
        </div>
      </div>
    </div>

