<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nelofy | Admin Dashboard</title>
    <meta
      name="description"
      content="Admin panel untuk mengelola pengguna, transaksi, dan pesanan pada platform Nelofy."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script>
      // Set base_url_api
      localStorage.setItem('base_url_api', '<%= process.env.BASE_API_URL %>');
    </script>
    <link rel="icon" href="../../assets/favicon.png" />
    <link rel="stylesheet" href="../../assets/css/global.css" />
    <link rel="stylesheet" href="../../assets/css/dashboard.css" />
    <script defer src="../../assets/javascript/global.js"></script>
    <script defer src="../../assets/javascript/navbar.js"></script>
    <script defer src="../../assets/javascript/dashboard.js"></script>

    <style>
      /* Dynamic Admin Sections */
      .admin-section {
        display: none;
      }
      .admin-section.active {
        display: block;
      }

      /* Sidebar Menu styling */
      .sidebar-link {
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 6px;
        display: block;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
      }
      .sidebar-link:hover,
      .sidebar-link.active {
        color: var(--black);
        background: var(--gray-100);
        font-weight: 600;
      }
      [data-theme='dark'] .sidebar-link:hover,
      [data-theme='dark'] .sidebar-link.active {
        color: var(--white);
        background: #27272a;
      }

      /* Dashboard Overview Cards */
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }
      .stat-card {
        background: var(--white);
        border: 1px solid var(--gray-200);
        padding: 24px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition:
          transform 0.2s,
          box-shadow 0.2s;
      }
      .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      }
      .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: var(--gray-100);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--black);
        font-size: 20px;
      }
      .stat-info h3 {
        font-size: 13px;
        color: var(--gray-500);
        font-weight: 500;
        margin: 0;
      }
      .stat-info p {
        font-size: 24px;
        font-weight: 700;
        color: var(--black);
        margin: 4px 0 0 0;
      }

      /* Admin Tables */
      .admin-table-wrapper {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        overflow-x: auto;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
      }
      .admin-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 14px;
      }
      .admin-table th {
        background: var(--gray-50);
        padding: 14px 18px;
        font-weight: 600;
        color: var(--gray-600);
        border-bottom: 1px solid var(--gray-200);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .admin-table td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--gray-150);
        color: var(--gray-800);
        vertical-align: middle;
      }
      .admin-table tr:last-child td {
        border-bottom: none;
      }
      .admin-table tr:hover td {
        background: var(--gray-50);
      }

      /* Action Buttons */
      .action-buttons {
        display: flex;
        gap: 6px;
      }
      .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid var(--gray-300);
        background: var(--white);
        color: var(--gray-700);
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-action:hover {
        border-color: var(--black);
        color: var(--black);
        background: var(--gray-100);
      }
      .btn-action.btn-delete:hover {
        border-color: var(--red);
        color: var(--white);
        background: var(--red);
      }
      .btn-action svg {
        width: 14px;
        height: 14px;
        stroke-width: 2.2;
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 99px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }
      .badge-success {
        background: #dcfce7;
        color: #166534;
      }
      .badge-pending {
        background: #fef9c3;
        color: #854d0e;
      }
      .badge-expired {
        background: #fee2e2;
        color: #991b1b;
      }
      .badge-active {
        background: #e0f2fe;
        color: #0369a1;
      }
      .badge-inactive {
        background: #f3f4f6;
        color: #4b5563;
      }
      .badge-admin {
        background: #f3e8ff;
        color: #6b21a8;
      }
      .badge-user {
        background: #e0f2fe;
        color: #0369a1;
      }

      /* Modals / Forms styles */
      .modal-form-group {
        margin-bottom: 16px;
        text-align: left;
      }
      .modal-form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--gray-700);
      }
      .modal-form-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--gray-300);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        background: var(--white);
        color: var(--black);
        font-family: var(--font);
        transition: border-color 0.2s;
      }
      .modal-form-input:focus {
        border-color: var(--black);
      }

      /* Dark Theme Overrides */
      [data-theme='dark'] .stat-card,
      [data-theme='dark'] .admin-table-wrapper,
      [data-theme='dark'] .btn-action,
      [data-theme='dark'] .modal-form-input {
        background: #18181b;
        border-color: #27272a;
        color: #e4e4e7;
      }
      [data-theme='dark'] .admin-table th {
        background: #202023;
        color: #a1a1aa;
        border-bottom-color: #27272a;
      }
      [data-theme='dark'] .admin-table td {
        color: #e4e4e7;
        border-bottom-color: #27272a;
      }
      [data-theme='dark'] .admin-table tr:hover td {
        background: #202023;
      }
      [data-theme='dark'] .stat-icon {
        background: #27272a;
        color: #fff;
      }
      [data-theme='dark'] .stat-info h3 {
        color: #a1a1aa;
      }
      [data-theme='dark'] .stat-info p {
        color: #fff;
      }
      [data-theme='dark'] .modal-form-group label {
        color: #a1a1aa;
      }
      [data-theme='dark'] .product-modal-content {
        background: #18181b;
        color: #fff;
      }
    </style>
  </head>

  <body>
    <!-- ─── TOP ANNOUNCEMENT BAR ─── -->
    <div id="topbar"></div>

    <!-- ─── NAVBAR ─── -->
    <nav class="navbar"></nav>

    <!-- ─── FILTER BAR ─── -->
    <div class="filter-section">
      <div class="container">
        <div class="filter-bar">
          <span class="filter-label" id="total-product-label">Overview Panel</span>
          <span class="filter-spacer"></span>

          <!--SEARCH BAR-->
          <div class="search-wrapper" id="admin-search-wrapper" style="display: none">
            <svg
              class="search-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="admin-search"
              class="search-input"
              placeholder="Cari..."
              autocomplete="off"
            />
          </div>

          <button
            class="filter-open-btn"
            id="filter-open-btn"
            onclick="openSidebarFilter()"
            style="display: none; border-radius: 20px; margin-left: 8px"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <line x1="4" y1="6" x2="20" y2="6" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="18" x2="20" y2="18" />
            </svg>
            Filter
          </button>

          <!-- ADD BUTTON -->
          <button
            class="filter-open-btn active"
            id="btn-add-entity"
            style="
              display: none;
              border-radius: 20px;
              background: var(--black);
              color: var(--white);
              border-color: var(--black);
              font-weight: 600;
              margin-left: 8px;
            "
          >
            + Tambah
          </button>
        </div>
      </div>
    </div>

    <!-- ─── MAIN GRID & SIDEBAR ─── -->
    <div class="container main-layout">
      <!-- SIDEBAR -->
      <aside class="sidebar-filter" id="sidebar-filter">
        <div class="sidebar-header">
          <h3>Menu</h3>
          <button class="sidebar-close-btn" onclick="closeSidebarFilter()">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Menu Admin -->
        <div class="sidebar-block">
          <h4 class="sidebar-title">Menu Admin</h4>
          <ul
            style="
              list-style: none;
              padding: 0;
              margin: 0;
              display: flex;
              flex-direction: column;
              gap: 6px;
            "
          >
            <li>
              <a href="#" class="sidebar-link active" data-tab="dashboard">Dashboard</a>
            </li>
            <li>
              <a href="#" class="sidebar-link" data-tab="user">User</a>
            </li>
            <li>
              <a href="#" class="sidebar-link" data-tab="order">Order</a>
            </li>
          </ul>
        </div>

        <!-- User Filters (Active on user tab) -->
        <div class="sidebar-block filter-group" id="filter-user-role" style="display: none">
          <h4 class="sidebar-title">Filter Role</h4>
          <label class="sidebar-check">
            <input
              type="radio"
              name="user-role-filter"
              class="user-filter-radio"
              value="all"
              checked
            />
            Semua
          </label>
          <label class="sidebar-check">
            <input type="radio" name="user-role-filter" class="user-filter-radio" value="admin" />
            Admin
          </label>
          <label class="sidebar-check">
            <input type="radio" name="user-role-filter" class="user-filter-radio" value="user" />
            User
          </label>
        </div>
        <div class="sidebar-block filter-group" id="filter-user-status" style="display: none">
          <h4 class="sidebar-title">Filter Status</h4>
          <label class="sidebar-check">
            <input
              type="radio"
              name="user-status-filter"
              class="user-filter-radio"
              value="all"
              checked
            />
            Semua
          </label>
          <label class="sidebar-check">
            <input
              type="radio"
              name="user-status-filter"
              class="user-filter-radio"
              value="active"
            />
            Aktif
          </label>
          <label class="sidebar-check">
            <input
              type="radio"
              name="user-status-filter"
              class="user-filter-radio"
              value="inactive"
            />
            Nonaktif
          </label>
        </div>

        <!-- Order Filters (Active on order tab) -->
        <div class="sidebar-block filter-group" id="filter-order-status" style="display: none">
          <h4 class="sidebar-title">Filter Status Order</h4>
          <label class="sidebar-check">
            <input
              type="radio"
              name="order-status-filter"
              class="order-filter-radio"
              value="all"
              checked
            />
            Semua
          </label>
          <label class="sidebar-check">
            <input
              type="radio"
              name="order-status-filter"
              class="order-filter-radio"
              value="SUCCESS"
            />
            SUCCESS
          </label>
          <label class="sidebar-check">
            <input
              type="radio"
              name="order-status-filter"
              class="order-filter-radio"
              value="PENDING"
            />
            PENDING
          </label>
          <label class="sidebar-check">
            <input
              type="radio"
              name="order-status-filter"
              class="order-filter-radio"
              value="EXPIRED"
            />
            EXPIRED
          </label>
        </div>
      </aside>
      <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebarFilter()"></div>

      <!-- MAIN DYNAMIC CONTENT SECTIONS -->
      <section class="products-section">
        <!-- 1. DASHBOARD OVERVIEW SECTION -->
        <div id="section-dashboard" class="admin-section active">
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-icon">👤</div>
              <div class="stat-info">
                <h3>Total Pengguna</h3>
                <p id="stat-total-users">—</p>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">🛍️</div>
              <div class="stat-info">
                <h3>Total Pesanan</h3>
                <p id="stat-total-orders">—</p>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">💰</div>
              <div class="stat-info">
                <h3>Total Pendapatan</h3>
                <p id="stat-total-revenue">—</p>
              </div>
            </div>
          </div>

          <div
            style="
              background: var(--white);
              padding: 30px;
              border-radius: 12px;
              border: 1px solid var(--gray-200);
              text-align: center;
            "
            class="stat-card"
          >
            <div style="font-size: 40px; margin-bottom: 12px">👋</div>
            <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 8px">
              Selamat Datang di Panel Admin Nelofy
            </h2>
            <p style="color: var(--gray-500); font-size: 14px; max-width: 500px; margin: 0 auto">
              Gunakan menu sidebar untuk mengelola akun pengguna, memeriksa transaksi masuk,
              memperbarui status invoice, dan mengawasi jalannya e-learning Nelofy.
            </p>
          </div>
        </div>

        <!-- 2. USER MANAGEMENT SECTION -->
        <div id="section-user" class="admin-section">
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nama Lengkap</th>
                  <th>Username</th>
                  <th>Email</th>
                  <th>No. Telp</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th style="width: 130px; text-align: center">Aksi</th>
                </tr>
              </thead>
              <tbody id="user-table-body">
                <!-- User rows render dynamically -->
              </tbody>
            </table>
          </div>

          <!-- PAGINATION -->
          <div class="pagination" id="user-pagination">
            <!-- Dynamic user pagination buttons -->
          </div>
        </div>

        <!-- 3. ORDER MANAGEMENT SECTION -->
        <div id="section-order" class="admin-section">
          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Invoice ID</th>
                  <th>Pelanggan</th>
                  <th>Produk</th>
                  <th>Total Bayar</th>
                  <th>Status</th>
                  <th>Tanggal dibuat</th>
                  <th style="width: 130px; text-align: center">Aksi</th>
                </tr>
              </thead>
              <tbody id="order-table-body">
                <!-- Order rows render dynamically -->
              </tbody>
            </table>
          </div>

          <!-- PAGINATION -->
          <div class="pagination" id="order-pagination">
            <!-- Dynamic order pagination buttons -->
          </div>
        </div>
      </section>
    </div>
    <!-- /container -->

    <!-- ─── FOOTER ─── -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-bottom" style="border-top: none; padding-top: 0">
          <p>&copy; 2026 Nelofy Admin Panel. Seluruh hak cipta dilindungi.</p>
        </div>
      </div>
    </footer>

    <!-- ─── USER ADD/EDIT MODAL ─── -->
    <div
      class="product-modal-overlay"
      id="user-modal-overlay"
      style="
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
      "
    >
      <div
        class="product-modal"
        style="
          display: block;
          position: relative;
          max-width: 500px;
          width: 90%;
          max-height: 90vh;
          overflow-y: auto;
        "
      >
        <button class="product-modal-close" onclick="closeUserModal()" title="Tutup">
          &times;
        </button>
        <div class="product-modal-content" style="padding: 24px">
          <h2 id="user-modal-title" style="margin-bottom: 20px; font-size: 20px; font-weight: 700">
            Tambah User
          </h2>
          <form id="user-form" onsubmit="saveUserForm(event)">
            <input type="hidden" id="user-form-id" />

            <div class="modal-form-group">
              <label for="uf-fullname">Nama Lengkap</label>
              <input
                type="text"
                id="uf-fullname"
                class="modal-form-input"
                required
                placeholder="Contoh: John Doe"
              />
            </div>

            <div class="modal-form-group">
              <label for="uf-username">Username</label>
              <input
                type="text"
                id="uf-username"
                class="modal-form-input"
                required
                placeholder="Contoh: johndoe"
              />
            </div>

            <div class="modal-form-group">
              <label for="uf-email">Alamat Email</label>
              <input
                type="email"
                id="uf-email"
                class="modal-form-input"
                required
                placeholder="Contoh: john@example.com"
              />
            </div>

            <div class="modal-form-group">
              <label for="uf-phone">Nomor Telepon</label>
              <input
                type="tel"
                id="uf-phone"
                class="modal-form-input"
                required
                placeholder="Contoh: 08123456789"
              />
            </div>

            <div class="modal-form-group">
              <label for="uf-role">Role</label>
              <select id="uf-role" class="modal-form-input" style="padding: 10px">
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>

            <div class="modal-form-group">
              <label for="uf-status">Status Akun</label>
              <select id="uf-status" class="modal-form-input" style="padding: 10px">
                <option value="active">Aktif</option>
                <option value="inactive">Nonaktif</option>
              </select>
            </div>

            <div class="modal-form-group">
              <label for="uf-password" id="uf-password-label">Password</label>
              <input
                type="password"
                id="uf-password"
                class="modal-form-input"
                placeholder="Masukkan password"
              />
              <small
                id="uf-password-hint"
                style="display: none; color: var(--gray-500); font-size: 11px; margin-top: 4px"
                >Biarkan kosong jika tidak ingin mengubah password.</small
              >
            </div>

            <button
              type="submit"
              class="pm-buy-btn"
              id="btn-submit-user"
              style="width: 100%; justify-content: center; margin-top: 10px; border-radius: 8px"
            >
              Simpan Perubahan
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- ─── USER DETAIL MODAL ─── -->
    <div
      class="product-modal-overlay"
      id="user-detail-overlay"
      style="
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
      "
    >
      <div
        class="product-modal"
        style="display: block; position: relative; max-width: 450px; width: 90%"
      >
        <button class="product-modal-close" onclick="closeUserDetailModal()" title="Tutup">
          &times;
        </button>
        <div class="product-modal-content" style="padding: 24px">
          <h2 style="margin-bottom: 20px; font-size: 20px; font-weight: 700">Detail Pengguna</h2>
          <div
            style="display: flex; flex-direction: column; gap: 14px; text-align: left"
            id="user-detail-content"
          >
            <!-- Rendered dynamically -->
          </div>
        </div>
      </div>
    </div>

    <!-- ─── ORDER ADD/EDIT MODAL ─── -->
    <div
      class="product-modal-overlay"
      id="order-modal-overlay"
      style="
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
      "
    >
      <div
        class="product-modal"
        style="
          display: block;
          position: relative;
          max-width: 500px;
          width: 90%;
          max-height: 90vh;
          overflow-y: auto;
        "
      >
        <button class="product-modal-close" onclick="closeOrderModal()" title="Tutup">
          &times;
        </button>
        <div class="product-modal-content" style="padding: 24px">
          <h2 id="order-modal-title" style="margin-bottom: 20px; font-size: 20px; font-weight: 700">
            Tambah Order
          </h2>
          <form id="order-form" onsubmit="saveOrderForm(event)">
            <input type="hidden" id="order-form-id" />

            <div class="modal-form-group">
              <label for="of-user">Pelanggan</label>
              <select id="of-user" class="modal-form-input" required style="padding: 10px">
                <option value="">Pilih Pelanggan...</option>
                <!-- Rendered dynamically -->
              </select>
            </div>

            <div class="modal-form-group">
              <label for="of-product">Produk</label>
              <select
                id="of-product"
                class="modal-form-input"
                required
                style="padding: 10px"
                onchange="onProductSelectChange()"
              >
                <option value="">Pilih Produk...</option>
                <!-- Rendered dynamically -->
              </select>
            </div>

            <div class="modal-form-group">
              <label for="of-amount">Total Bayar (Rp)</label>
              <input
                type="number"
                id="of-amount"
                class="modal-form-input"
                required
                placeholder="Contoh: 150000"
              />
            </div>

            <div class="modal-form-group">
              <label for="of-status">Status Transaksi</label>
              <select id="of-status" class="modal-form-input" style="padding: 10px">
                <option value="PENDING">PENDING</option>
                <option value="SUCCESS">SUCCESS</option>
                <option value="EXPIRED">EXPIRED</option>
              </select>
            </div>

            <button
              type="submit"
              class="pm-buy-btn"
              id="btn-submit-order"
              style="width: 100%; justify-content: center; margin-top: 10px; border-radius: 8px"
            >
              Simpan Perubahan
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- ─── ORDER DETAIL MODAL ─── -->
    <div
      class="product-modal-overlay"
      id="order-detail-overlay"
      style="
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
      "
    >
      <div
        class="product-modal"
        style="
          display: block;
          position: relative;
          max-width: 500px;
          width: 90%;
          max-height: 90vh;
          overflow-y: auto;
        "
      >
        <button class="product-modal-close" onclick="closeOrderDetailModal()" title="Tutup">
          &times;
        </button>
        <div class="product-modal-content" style="padding: 24px">
          <h2 style="margin-bottom: 20px; font-size: 20px; font-weight: 700">
            Detail Transaksi Order
          </h2>
          <div
            style="display: flex; flex-direction: column; gap: 14px; text-align: left"
            id="order-detail-content"
          >
            <!-- Rendered dynamically -->
          </div>
        </div>
      </div>
    </div>

    <!-- ─── TOAST CONTAINER ─── -->
    <div id="toast-container" class="toast-container"></div>

    <!-- ─── CONFIRM MODAL ─── -->
    <div class="confirm-overlay" id="confirm-overlay">
      <div class="confirm-modal">
        <div class="confirm-title" id="confirm-title">Konfirmasi</div>
        <div class="confirm-message" id="confirm-message">Apakah Anda yakin?</div>
        <div class="confirm-actions">
          <button class="btn-confirm-cancel" id="confirm-cancel-btn">Batal</button>
          <button class="btn-confirm-ok" id="confirm-ok-btn">Ya, Yakin</button>
        </div>
      </div>
    </div>
  </body>
</html>
